# Deixe URL e chave vazias para avaliação local, sem persistência remota.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Contas fictícias previamente criadas em Supabase Auth. Nenhuma conta real.
VITE_DEMO_ANA_EMAIL=ana@conexa.invalid
VITE_DEMO_JOAO_EMAIL=joao@conexa.invalid
VITE_DEMO_BUYER_EMAIL=comprador@conexa.invalid
VITE_DEMO_CARRIER_EMAIL=transporte@conexa.invalid
# Senha pública e descartável exclusiva dessas contas de demonstração.
# Variáveis VITE_ são visíveis no navegador. Nunca usar service_role aqui.
VITE_DEMO_PASSWORD=
# Acesso às contas fictícias: sempre disponível no servidor de desenvolvimento.
# Em build/deploy, habilite somente em um ambiente de demonstração isolado.
VITE_ENABLE_DEVELOPER_ACCESS=false
# Somente exibe a entrada opcional. Não inicia sessões; servidor separado exige configuração.
VITE_CONEXA_VOICE_ENABLED=false
# Chave pública exclusiva da Maps Embed API, restrita por HTTP referrer e API.
# Opcional: sem chave, o roteiro fictício permanece disponível, sem chamar Google Maps.
VITE_GOOGLE_MAPS_EMBED_KEY=
# Cálculo de distância/frete: configure GOOGLE_MAPS_ROUTES_KEY em .env.routes,
# seguindo .env.routes.example. A chave Routes é privada e nunca usa VITE_.
