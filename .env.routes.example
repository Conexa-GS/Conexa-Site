# Credencial PRIVADA, exclusiva da Routes API. Nunca usar prefixo VITE_.
GOOGLE_MAPS_ROUTES_KEY=
CONEXA_ROUTES_ORIGIN=http://localhost:5173
CONEXA_ROUTES_PORT=8788
# O comando dev:routes também lê .env; reutiliza URL e chave publicável VITE_SUPABASE_*.
