# Copie para .env.voice (ignorado pelo Git). Nunca use VITE_ nestes segredos.
# Servidor local opcional, uma única instância, Node >=24. Não publicar como serverless.
CONEXA_VOICE_ENABLED=false
OPENAI_API_KEY=
# Defina modelos disponíveis na sua conta; nenhum modelo/preço é presumido.
OPENAI_REALTIME_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CONEXA_VOICE_ORIGIN=http://localhost:5173
CONEXA_VOICE_PORT=8787
# Tetos operacionais, não orçamento monetário garantido.
CONEXA_VOICE_MAX_SECONDS=60
CONEXA_VOICE_DAILY_SESSIONS=2
CONEXA_VOICE_MAX_RESPONSES=4
CONEXA_VOICE_OUTPUT_TOKENS=256
